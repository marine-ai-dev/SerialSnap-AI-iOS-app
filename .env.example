# Copy to .env and fill in real values locally. Never commit .env.
# These map to Supabase project settings (Project Settings > API).

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anonymous/public API key (safe to embed in a client — every
# request it makes is still subject to Row Level Security). NEVER put the
# service-role key here or anywhere client-reachable.
SUPABASE_ANON_KEY=

# Optional: only used by trusted server-side/CI jobs that must bypass RLS
# deliberately (e.g. running seed scripts). Never ships in the app.
# SUPABASE_SERVICE_ROLE_KEY=

# Sign in with Apple — Services ID / bundle identifier used for the
# associated domain + Apple authentication configuration in the Supabase
# Auth provider settings.
APPLE_SIGN_IN_SERVICE_ID=
